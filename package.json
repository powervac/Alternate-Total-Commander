{
  "name": "commander",
  "version": "0.1.921",
  "description": "Two-panel file manager (Total Commander style) for Windows and macOS: zip, Synology NAS, SSH console, viewer, music player",
  "main": "src/main/main.js",
  "scripts": {
    "release": "node tools/release.js",
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "icon": "node tools/make-icon.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "7zip-bin": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "node-unrar-js": "^2.0.2",
    "ssh2": "^1.17.0",
    "word-extractor": "^1.0.4",
    "yauzl": "^3.4.0",
    "yazl": "^2.5.1"
  },
  "productName": "Commander",
  "author": "powervac",
  "build": {
    "appId": "local.commander.filemanager",
    "productName": "Commander",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/7zip-bin/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "Commander shows the files in your Desktop folder.",
        "NSDocumentsFolderUsageDescription": "Commander shows the files in your Documents folder.",
        "NSDownloadsFolderUsageDescription": "Commander shows the files in your Downloads folder.",
        "NSRemovableVolumesUsageDescription": "Commander shows the files on external drives.",
        "NSNetworkVolumesUsageDescription": "Commander shows the files on network volumes."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    },
    "appImage": {
      "artifactName": "Commander-${version}-x86_64.AppImage"
    },
    "portable": {
      "artifactName": "Commander-Portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
