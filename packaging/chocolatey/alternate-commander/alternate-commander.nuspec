<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>alternate-commander</id>
    <version>0.1.929</version>
    <title>Alternate Commander</title>
    <authors>powervac</authors>
    <owners>powervac</owners>
    <projectUrl>https://altcom.cc</projectUrl>
    <projectSourceUrl>https://github.com/powervac/Alternate-Total-Commander</projectSourceUrl>
    <bugTrackerUrl>https://github.com/powervac/Alternate-Total-Commander/issues</bugTrackerUrl>
    <docsUrl>https://altcom.cc</docsUrl>
    <iconUrl>https://raw.githubusercontent.com/powervac/Alternate-Total-Commander/main/build/icon.png</iconUrl>
    <licenseUrl>https://github.com/powervac/Alternate-Total-Commander/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>file-manager two-panel dual-pane total-commander ssh sftp dropbox google-drive archive portable foss cross-platform</tags>
    <summary>Two-panel file manager in the style of Total Commander</summary>
    <description>Alternate Commander is a keyboard-first two-panel file manager. Archives (zip, 7z, tar, rar and more) open like folders; Google Drive, Dropbox, Synology NAS and SSH/SFTP servers work as ordinary disks; Find Files, compare and synchronize folders, multi-rename, viewer and editor, music player and settings sync are built in. It is an unofficial project and is not affiliated with Total Commander / Ghisler Software.

This package installs the portable executable of the program from the GitHub release and adds a Start menu shortcut. The program updates itself (Configuration &gt; Check for Updates).</description>
    <releaseNotes>https://altcom.cc/changelog.html</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
